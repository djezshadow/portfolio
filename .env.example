# Creá una base gratis en https://neon.tech (o cualquier Postgres) y pegá la connection string acá.
DATABASE_URL="postgresql://usuario:password@host/db?sslmode=require"

# Generá esto con: npx tsx scripts/hash-password.ts "tuPasswordSegura"
ADMIN_PASSWORD_HASH=""

# Cualquier string larga y random (ej: openssl rand -base64 32)
ADMIN_JWT_SECRET=""

# Panel de Vercel → Storage → Blob → creá un store y copiá el token
BLOB_READ_WRITE_TOKEN=""

# URL final del sitio (para SEO, sitemap y OG tags)
SITE_URL="https://tu-dominio.vercel.app"

# https://resend.com (plan free alcanza) → API Key
RESEND_API_KEY=""
CONTACT_EMAIL_TO="tu-email@ejemplo.com"

# Opcional: solo si querés mostrar el botón de WhatsApp en /contacto
NEXT_PUBLIC_WHATSAPP_NUMBER=""

# Opcional: por defecto ya usa "djezshadow" si no la seteás
NEXT_PUBLIC_INSTAGRAM_HANDLE="djezshadow"
