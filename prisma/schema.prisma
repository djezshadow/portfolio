generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ThemeMode {
  auto
  manual
}

enum ThemeName {
  noir
  neon
}

enum LogoSource {
  upload
  from_category
  none
}

enum MediaType {
  image
  video
}

enum VideoProvider {
  youtube
  vimeo
}

/// Cada categoría es una "carpeta estética": tiene su propio tema
/// (manual/auto) y su propio estilo tipográfico/visual.
model Category {
  id              String            @id @default(cuid())
  slug            String            @unique
  name            String
  /// Si queda vacío, se usa `name` (español) también en inglés.
  nameEn          String?
  order           Int               @default(0)
  themeMode       ThemeMode         @default(auto)
  themeName       ThemeName?
  /// SEO manual (item #42). Si quedan vacíos, se autogeneran a partir del nombre.
  metaTitle       String?
  metaTitleEn     String?
  metaDescription String?
  metaDescriptionEn String?
  /// Categoría "en pausa": se ve gris/bloqueada en destacados y nav, con
  /// un popup mostrando `comingSoonHint` al tocarla.
  isComingSoon    Boolean           @default(false)
  comingSoonHint  String?
  comingSoonHintEn String?
  /// Mensaje del easter egg de 6 toques en la pantalla de "signo de
  /// pregunta" (cuando entrás por URL directa) — a propósito
  /// INDEPENDIENTE de comingSoonHint: uno es la pista pública del popup,
  /// este es el secreto que solo ve quien encuentra el easter egg.
  easterEggMessage   String?
  easterEggMessageEn String?
  /// Si está en true, aparece como link en el navbar flotante público
  /// (independiente de isComingSoon — así podés linkear el "coming soon"
  /// desde la nav aunque no salga en destacados).
  showInNav       Boolean           @default(false)
  /// Portada de la categoría (item #17) — se usa en el carrusel de
  /// destacados de la home para que se vea más atractivo. Si queda vacía,
  /// se muestra la card sin imagen (como antes).
  coverImageUrl   String?
  /// Se calcula solo al subir la portada (item #22-bis: "que el texto se
  /// adapte al fondo") — analiza el brillo real de la foto con sharp y
  /// decide si el texto sobre ella necesita ser claro u oscuro para
  /// tener contraste, así no importa qué tan clara u oscura sea la foto
  /// que subas.
  coverTextDark   Boolean           @default(false)
  style           CategoryStyle?
  projects        ProjectCategory[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

/// Personalización visual por categoría (item #22 del spec).
model CategoryStyle {
  id            String   @id @default(cuid())
  categoryId    String   @unique
  category      Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  accentColor   String? // hex, pisa --accent solo dentro de esta categoría
  fontFamily    String? // "display" | "body" | "mono" (fuentes curadas)
  bold          Boolean  @default(false)
  strikethrough Boolean  @default(false)
  alignment     String   @default("left") // left | center | right
  strokeWidth   Float? // px, para -webkit-text-stroke en títulos
}

model Collaborator {
  id        String           @id @default(cuid())
  name      String
  /// Slug del tipo de relación — antes era un enum fijo (client/creative),
  /// ahora referencia CollaboratorTypeOption.slug para que el admin pueda
  /// crear/borrar tipos nuevos (item #14). Sigue siendo un string simple
  /// para no perder los valores "client"/"creative" que ya existen.
  type      String           @default("client")
  typeOption CollaboratorTypeOption? @relation(fields: [type], references: [slug])
  logoUrl   String?
  instagram String?
  website   String?
  /// Participantes opcionales dentro de este colaborador (item #16):
  /// personas puntuales con su rol y redes, todo opcional.
  participants Participant[]
  projects  Project[]
}

/// Tipos de relación personalizables (item #14). isClient decide en qué
/// sección de la vista pública cae ("Clientes" o "Colaboradores", item #8).
model CollaboratorTypeOption {
  id            String         @id @default(cuid())
  slug          String         @unique
  name          String
  nameEn        String?
  isClient      Boolean        @default(false)
  order         Int            @default(0)
  collaborators Collaborator[]
}

/// Persona puntual dentro de un Collaborator (item #16). Todo opcional
/// salvo que tenga sentido tener al menos un nombre.
model Participant {
  id             String       @id @default(cuid())
  collaboratorId String
  collaborator   Collaborator @relation(fields: [collaboratorId], references: [id], onDelete: Cascade)
  name           String?
  role           String?
  roleEn         String?
  instagram      String?
  website        String?
  order          Int          @default(0)
}

model Project {
  id             String            @id @default(cuid())
  title          String
  titleEn        String?
  description    String?
  descriptionEn  String?
  /// Rango de fechas del proyecto/colaboración (item pendiente: "fechas
  /// año a año, o actualidad"). dateEnd queda null si isOngoing es true.
  dateStart      DateTime?
  dateEnd        DateTime?
  isOngoing      Boolean           @default(false)
  role           String?
  roleEn         String?
  logoSource     LogoSource        @default(none)
  logoUrl        String?
  featured       Boolean           @default(false)
  order          Int               @default(0)
  /// Coming Soon a nivel proyecto (mismo mecanismo que Category, ver
  /// más abajo): el proyecto se ve pero bloqueado, gris/candado, con un
  /// mensaje propio al tocarlo — hasta que se destilda.
  isComingSoon     Boolean @default(false)
  comingSoonHint   String?
  comingSoonHintEn String?
  /// Acceso directo del proyecto en el navbar (además de vivir dentro de
  /// su categoría) — respeta el mismo bloqueo/desbloqueo de Coming Soon.
  showInNav        Boolean @default(false)
  /// null = borrador (nunca se muestra en el sitio público).
  /// fecha futura = programado. fecha pasada/ahora = publicado.
  publishedAt    DateTime?
  collaboratorId String?
  collaborator   Collaborator?     @relation(fields: [collaboratorId], references: [id], onDelete: SetNull)
  categories     ProjectCategory[]
  media          Media[]
  mediaGroups    MediaGroup[]
  tags           ProjectTag[]
  createdAt      DateTime          @default(now())
}

/// Un proyecto puede vivir en más de una categoría (item #8).
model ProjectCategory {
  projectId  String
  categoryId String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([projectId, categoryId])
}

model Tag {
  id       String       @id @default(cuid())
  name     String       @unique
  projects ProjectTag[]
}

model ProjectTag {
  projectId String
  tagId     String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([projectId, tagId])
}

model Media {
  id            String         @id @default(cuid())
  projectId     String
  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type          MediaType
  url           String // imagen: archivo ORIGINAL, sin watermark — se conserva siempre para poder re-hornear si cambiás la marca de agua
  /// Si es false, esta foto puntual nunca lleva watermark aunque esté
  /// activado globalmente (se elige al subirla).
  watermarkEnabled Boolean     @default(true)
  /// Overrides puntuales por foto — si están seteados, pisan la config
  /// global de Configuración SOLO para esta foto (pedido: "algunas fotos
  /// corregirles la marca de agua manualmente... moverlas un poco o
  /// bajar la opacidad exclusivamente a algunas").
  watermarkPositionOverride String?
  watermarkOpacityOverride  Float?
  /// Versión ya HORNEADA (watermark aplicado si corresponde, o solo
  /// redimensionada si no) lista para servir directo desde el Blob, sin
  /// procesar nada en cada visita. Se genera al subir la foto y se
  /// regenera con "Aplicar marca de agua a todas las fotos". Mientras es
  /// null (foto recién subida antes de tener esto, o justo en medio de un
  /// reprocesado) se sirve al vuelo por /api/media/[id] como respaldo.
  bakedThumbUrl String? // ~800px, para grillas/cards
  bakedFullUrl  String? // ~2000px, para el visor grande
  videoProvider VideoProvider?
  videoId       String? // id de YouTube/Vimeo
  order         Int            @default(0)
  isThumbnail   Boolean        @default(false)
  /// Subcategoría opcional dentro del proyecto (item #13 del pedido:
  /// dividir un mismo proyecto por fecha, tipo de trabajo, etc).
  groupId       String?
  group         MediaGroup?    @relation(fields: [groupId], references: [id], onDelete: SetNull)
}

/// Subcategoría dentro de un proyecto (ej: "Making of", "Fotos finales",
/// "Marzo 2026"). El admin las crea/borra libremente por proyecto, y cada
/// una puede tener su propia portada (sube una propia o usa una de las
/// fotos que ya tiene adentro).
model MediaGroup {
  id             String   @id @default(cuid())
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name           String
  nameEn         String?
  order          Int      @default(0)
  coverImageUrl  String?
  media          Media[]
}

/// Fila única de configuración global del sitio.
model SiteSettings {
  id             String  @id @default("default")
  updatedAt      DateTime @default(now()) @updatedAt
  /// Logo PNG/WebP subido por el admin. Si está seteado, reemplaza al
  /// ícono de diafragma en el watermark de todas las fotos nuevas.
  watermarkUrl   String?
  /// % del ancho de la foto que ocupa el watermark (por defecto 9%, igual
  /// que el ícono de diafragma original).
  watermarkScale Float   @default(9)
  /// Opacidad y posición por defecto — antes vivían sueltas en cada
  /// formulario de proyecto y no se guardaban en ningún lado.
  watermarkOpacity  Float  @default(40)
  watermarkPosition String @default("bottom-right")

  /// Textos del hero de la home (item pendiente: "título/subtítulo editable").
  /// Si quedan vacíos, se usa el texto por defecto del diccionario ES/EN.
  heroTitle1     String?
  heroTitle1En   String?
  heroTitle2     String?
  heroTitle2En   String?
  heroSubtitle   String?
  heroSubtitleEn String?

  /// La etiqueta chica arriba del título del hero (default "REEL —
  /// 00:00:00:00", estética de timecode de editor de video). Editable
  /// porque no es obligatorio mantener el look de timecode.
  heroKicker             String?
  heroKickerEn           String?
  heroKickerShowTimecode Boolean @default(true)

  /// Preset visual del carrusel de destacados: "cards" | "minimal" | "stack"
  carouselPreset String  @default("cards")
  /// Alineación general de la home (pendiente del PDF: "alineación
  /// configurable del Home") — aplica al hero (kicker/título/subtítulo/
  /// botones) y al encabezado de la sección de destacados.
  homeAlign String @default("left") // left | center | right

  /// Personalización fina del carrusel de destacados, por encima del
  /// preset elegido (pendiente del PDF: "personalización individual por
  /// carrusel"). Todo opcional — sin tocar nada, cada preset se ve como
  /// siempre.
  carouselItemSize   String  @default("md") // sm | md | lg — alto de las cards
  carouselGap        Int     @default(16) // separación entre ítems, en px
  carouselBackground String  @default("transparent") // transparent | surface
  carouselShadow     Boolean @default(false)
  carouselGlass      Boolean @default(true)
  /// Alineación de la fila/grilla del carrusel dentro de su contenedor
  /// (pendiente del PDF: "opciones de alineación del carrusel").
  carouselAlign      String  @default("left") // left | center | right

  /// Logo de marca, uno para cada tema (PNG blanco para Neón, negro para
  /// Noir, por ejemplo). Si no hay ninguno cargado, se muestra el texto
  /// "DJEZSHADOW" como wordmark.
  logoNoirUrl    String?
  logoNeonUrl    String?
  /// Si es true (default), el logo queda FIJO arriba mientras scrolleás
  /// (mobile: centrado arriba; desktop: esquina superior izquierda),
  /// nunca con caja. Si es false, el logo va incrustado arriba de la
  /// portada de la home y se desliza con la página como el resto del
  /// contenido — pensado por si en algún momento se prefiere eso, aunque
  /// el default es que quede fijo (en mobile importa que no se pierda al
  /// scrollear).
  logoFloating   Boolean @default(true)
  /// Alto del logo en píxeles (desktop) — mismo valor se usa tanto
  /// flotante como incrustado, así el admin ajusta uno solo y no se
  /// descoordinan.
  logoSize       Int     @default(64)
  /// Alto del logo en celular — independiente del de desktop porque el
  /// logo en mobile siempre es fijo arriba centrado (sin caja), así que
  /// necesita su propia medida.
  logoSizeMobile Int     @default(40)

  /// Mail donde llegan los mensajes de contacto — configurable acá para no
  /// depender de una variable de entorno y tener que redeployar para cambiarlo.
  /// Si queda vacío, se usa CONTACT_EMAIL_TO del .env como respaldo.
  contactEmail   String?

  /// Sección "Sobre mí / About Me" (item #21) — ultra personalizable:
  /// se puede prender/apagar del todo, el contenido se escribe en Markdown
  /// (listas, numeradas, subtítulos, negrita, etc) y admite CSS propio para
  /// cuando esto se venda como plantilla a otros clientes.
  aboutEnabled     Boolean @default(false)
  aboutTitle       String?
  aboutTitleEn     String?
  aboutContent     String? @db.Text
  aboutContentEn   String? @db.Text
  aboutImageUrl    String?
  /// CSS personalizado, separado por tema (pedido: "separar el CSS en
  /// dos cuadros NOIR/NEON") — cada uno se inyecta SOLO cuando ese tema
  /// está activo, así podés, por ejemplo, usar colores distintos en cada
  /// modo sin pelear con especificidad. `aboutCustomCss` (a secas) queda
  /// como el cuadro de Noir por compatibilidad con lo ya cargado.
  aboutCustomCss     String? @db.Text // CSS del tema Noir
  aboutCustomCssNeon String? @db.Text // CSS del tema Neón

  /// Animación de carga personalizada (gif o webp animado) — se sube tal
  /// cual, sin reprocesar con sharp, para no perder los frames de
  /// animación. Si no hay nada subido, se usa la animación default del
  /// sitio (tipo claqueta/timecode). Posición y tamaño configurables por
  /// separado para desktop y celular — pensado como "easter egg": jugá
  /// con la ubicación y el diseño.
  loadingAnimationUrl         String?
  loadingAnimationPosition       String  @default("center")
  loadingAnimationPositionMobile String  @default("center")
  loadingAnimationSize            Int    @default(120)
  loadingAnimationSizeMobile      Int    @default(90)

  /// Redes sociales del footer (item nuevo) — vacío = no se muestra ese
  /// ícono. Configurable acá, no hace falta tocar código para cambiar un
  /// link o sacar una red.
  footerInstagramUrl String?
  footerTiktokUrl    String?
  footerLinkedinUrl  String?
  footerYoutubeUrl   String?

  /// Orden custom del navbar (JSON: array de keys, ej:
  /// ["category:filmmaker","cv","contacto","colaboradores"]) — los items
  /// que no estén en la lista (categorías/proyectos nuevos) van al final
  /// en su orden natural. Se edita desde /admin/navbar.
  navOrder String? @db.Text
  /// Colaboradores/Contacto no tenían forma de ocultarse del navbar (a
  /// diferencia de categorías/proyectos que ya tienen showInNav, o Sobre
  /// mí/CV que se controlan con su propio enabled). Solo afecta el link
  /// del navbar — las páginas siguen accesibles por URL directa.
  colaboradoresInNav Boolean @default(true)
  contactoInNav      Boolean @default(true)
  /// Nombres personalizados para los ítems fijos del navbar (item nuevo:
  /// "que se puedan cambiar el nombre de las cosas del navbar"). JSON:
  /// {"home":{"es":"Inicio","en":"Home"}, "about":{...}, ...}. Vacío =
  /// usa el default de cada uno.
  navLabels String? @db.Text

  /// Integración con Instagram (pedido: "compartir mis destacadas y
  /// feed acá en mi portfolio"). Sin API de Meta de por medio — usa el
  /// embed público oficial de Instagram (oEmbed), por eso alcanza con
  /// guardar las URLs de los posts/reels que querés mostrar (ver modelo
  /// InstagramPost más abajo). Estos campos son solo la config general
  /// de la sección.
  instagramFeedEnabled Boolean @default(false)
  instagramHandle      String?
  instagramFeedTitle   String?
  instagramFeedTitleEn String?
}

/// Un post o reel de Instagram elegido a mano para mostrarse en el
/// portfolio (pedido: integración con Instagram para feed/destacadas).
/// `section` separa "lo más reciente" de "lo que quiero destacar" —
/// misma idea que Feed vs Historias Destacadas de Instagram, pero
/// curado por vos en vez de automático.
model InstagramPost {
  id        String   @id @default(cuid())
  url       String // link al post o reel (instagram.com/p/... o /reel/...)
  caption   String?
  section   String   @default("feed") // feed | highlight
  order     Int      @default(0)
  createdAt DateTime @default(now())
  /// Portada elegida a mano para el círculo de "Destacadas" (item: como
  /// Instagram no deja embeber Destacadas de verdad, mostramos un
  /// círculo con degradé + esta foto que redirige al link real). No se
  /// usa en "feed" — ahí el post se embebe entero con su propia imagen.
  coverImageUrl String?
}

/// Links manuales del navbar (item PDF #1.2) — para enlaces externos o
/// internos que no son ni categoría, ni proyecto, ni ninguna de las
/// secciones fijas del sitio.
model CustomNavLink {
  id      String @id @default(cuid())
  label   String
  labelEn String?
  url     String
  order   Int    @default(0)
}

/// Perfil para el CV descargable (item nuevo: "que la gente pueda desde mi
/// portfolio bajar mi CV actualizado"). Fila única (id fijo "default"),
/// mismo patrón que SiteSettings. Teléfono/dirección quedan opcionales y
/// vacíos por default a propósito — el CV nunca los muestra a menos que
/// vos mismo los cargues acá.
model Profile {
  id            String            @id @default("default")
  fullName      String?
  specialty     String?
  specialtyEn   String?
  bio           String?           @db.Text
  bioEn         String?           @db.Text
  photoUrl      String?
  email         String?
  phone         String?
  address       String?
  website       String?
  instagram     String?
  linkedin      String?
  /// Muestra el link/botón "Descargar CV" en el sitio público.
  cvEnabled     Boolean           @default(false)
  skills        Skill[]
  experiences   WorkExperience[]
}

model Skill {
  id        String  @id @default(cuid())
  profileId String  @default("default")
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name      String
  nameEn    String?
  order     Int     @default(0)
}

/// Experiencia laboral cargada a mano (además de los proyectos del
/// portfolio, que el CV toma automáticamente con sus fechas — esto es
/// para trabajos que no necesariamente están como proyecto acá, ej. un
/// puesto en relación de dependencia).
model WorkExperience {
  id            String    @id @default(cuid())
  profileId     String    @default("default")
  profile       Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  role          String
  roleEn        String?
  company       String?
  description   String?   @db.Text
  descriptionEn String?   @db.Text
  dateStart     DateTime?
  dateEnd       DateTime?
  isOngoing     Boolean   @default(false)
  order         Int       @default(0)
}
